---
import { u } from '../lib/url';
const p = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const cur = (s: string) => (p === s || p.startsWith(s + '/') ? 'page' : undefined);
const links = [
  { href: '/topics', label: 'Topics' },
  { href: '/calculators', label: 'Calculators' },
  { href: '/blog', label: 'Blog' },
];
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={u('/')} aria-label="Money Made Simple, home">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--accent)"/><path d="M5 22 C12 21 17 19 27 8" stroke="var(--accent-ink)" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M5 22 L27 18" stroke="var(--accent-ink)" stroke-opacity=".55" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
      Money Made Simple
    </a>
    <div class="actions">
      <nav class="nav" id="site-nav" aria-label="Main">
        {links.map((l) => <a href={u(l.href)} aria-current={cur(l.href)}>{l.label}</a>)}
      </nav>
      <button class="theme-btn" type="button" data-theme-toggle aria-label="Switch between light and dark mode">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button class="menu-btn" type="button" data-menu-toggle aria-controls="site-nav" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" x2="20" y1="7" y2="7"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="17" y2="17"/></svg>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>
