---
import SignupForm from './SignupForm.astro';
import { SITE } from '../config';
import { FINAL_GAP, START, YEARS, FLAT_RATE, GREEN_RATE, W, H, areaD, counterAnchor, flatPts, greenPts, gapLabel, lineD } from '../lib/hero-curves';

// Static, finished chart: what no-JS and reduced-motion visitors see, and what
// the animation settles on.
const flat = lineD(flatPts);
const green = lineD(greenPts);
const area = areaD(1);
const anchor = counterAnchor();
const cur = SITE.currency;
const money = (n: number) => `${cur}${n.toLocaleString(SITE.locale)}`;
---
<section class="hero" data-hero>
  <div class="wrap hero-grid">
    <div class="hero-head">
      <p class="eyebrow" data-hide style="--d:0">Free financial calculators</p>
      <h1 class="hero-title">
        <span class="ln" data-hide style="--d:0">See what your</span>
        <span class="ln" data-hide style="--d:1">money decisions</span>
        <span class="ln" data-hide style="--d:2">really cost.</span>
      </h1>
    </div>

    <div class="hero-action">
      <p class="tagline" data-tagline>{SITE.tagline}</p>
      <div class="hero-form" data-form>
        <p class="lead">Get free access to every calculator.</p>
        <SignupForm id="hero" cta="Unlock the calculators" />
      </div>
    </div>

    <figure class="hero-chart" data-chart>
      <div class="plot" role="img" aria-label={`Chart: ${money(START)} over ${YEARS} years grows ${money(Math.round(START * Math.pow(1 + FLAT_RATE, YEARS)))} at ${FLAT_RATE * 100}% a year but ${money(Math.round(START * Math.pow(1 + GREEN_RATE, YEARS)))} at ${GREEN_RATE * 100}%, a difference of ${money(FINAL_GAP)}.`}>
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false" data-svg>
          <defs>
            <linearGradient id="gap-a" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color:var(--accent)" stop-opacity=".34" />
              <stop offset="1" style="stop-color:var(--accent)" stop-opacity=".03" />
            </linearGradient>
            <linearGradient id="gap-b" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" style="stop-color:var(--accent)" stop-opacity=".02" />
              <stop offset="1" style="stop-color:var(--accent)" stop-opacity=".42" />
            </linearGradient>
            <filter id="glow-blur" x="-5%" y="-20%" width="110%" height="140%"><feGaussianBlur stdDeviation="6" /></filter>
          </defs>
          <line class="base" x1="14" y1={flatPts[0][1]} x2={W - 14} y2={flatPts[0][1]} />
          <g class="g-flat" data-g-flat>
            <path class="flat" data-flat d={flat} />
          </g>
          <g class="g-green" data-g-green>
            <path class="area" data-area d={area} fill="url(#gap-a)" />
            <path class="area shift" data-area2 d={area} fill="url(#gap-b)" />
            <path class="glow" data-glow d={green} filter="url(#glow-blur)" />
            <path class="green" data-green d={green} />
            <g data-dots></g>
          </g>
          <circle class="origin" cx={flatPts[0][0]} cy={flatPts[0][1]} r="5.5" />
        </svg>
        <div class="counter" data-counter style={`left:${anchor.left}%;top:${anchor.top}%`}>
          <span class="num" data-counter-num>{gapLabel(FINAL_GAP)}</span>
          <span class="cap">extra after {YEARS} years</span>
        </div>
      </div>
      <div class="axis" aria-hidden="true"><span>Today</span><span>{YEARS} years</span></div>
      <figcaption>
        <span class="key"><i class="k-flat"></i>The default ({FLAT_RATE * 100}% a year)</span>
        <span class="key"><i class="k-green"></i>The better move ({GREEN_RATE * 100}% a year)</span>
        <span class="note">Illustration: {money(START)} over {YEARS} years.</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding: clamp(24px, 5vw, 64px) 0 0; overflow-x: clip; }
  /* Phone: headline → chart → tagline + form (the chart is the star, the form lands last).
     Desktop: text on the left, chart on the right. */
  .hero-grid { display: grid; gap: 28px; grid-template-areas: 'head' 'chart' 'action'; }
  .hero-head { grid-area: head; }
  .hero-chart { grid-area: chart; }
  .hero-action { grid-area: action; }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); grid-template-areas: 'head chart' 'action chart'; column-gap: clamp(32px, 5vw, 64px); row-gap: 0; align-content: center; }
    .hero-chart { align-self: center; }
    .hero-head { align-self: end; }
  }
  .hero-title { margin-bottom: 0.3em; font-size: clamp(2.3rem, 5.6vw + 0.4rem, 4rem); }
  .ln { display: block; }
  .tagline { font: italic 600 clamp(1.3rem, 2vw + 0.8rem, 1.85rem)/1.2 var(--serif); color: var(--accent); margin: 0 0 18px; min-height: 1.3em; }
  .lead { margin-bottom: 14px; }

  .hero-chart { margin: 0; }
  .plot { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 10px; box-shadow: var(--shadow); }
  svg { width: 100%; height: auto; overflow: visible; }
  .base { stroke: var(--line); stroke-width: 1.5; stroke-dasharray: 3 6; }
  .flat { fill: none; stroke: var(--flat); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .green { fill: none; stroke: var(--accent); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
  .glow { fill: none; stroke: var(--accent); stroke-width: 11; stroke-linecap: round; opacity: 0; }
  .origin { fill: var(--surface); stroke: var(--ink); stroke-width: 2.5; }
  .area.shift { opacity: 0; }
  :global(.dot) { fill: var(--accent); }
  .g-flat, .g-green { transform: translate(calc(var(--px, 0) * var(--k, 1) * 7px), calc(var(--py, 0) * var(--k, 1) * 5px)); will-change: transform; }
  .g-flat { --k: 0.35; }
  .g-green { --k: 1; }

  .counter { position: absolute; transform: translate(-50%, -50%); text-align: center; pointer-events: none; display: grid; gap: 2px; }
  .counter .num { font: 700 clamp(1.15rem, 3.6vw, 2.1rem)/1 var(--serif); color: var(--accent); font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
  .counter .cap { font-size: clamp(0.62rem, 1.6vw, 0.78rem); color: var(--muted); letter-spacing: .02em; white-space: nowrap; }
  .counter .num { white-space: nowrap; }

  .axis { display: flex; justify-content: space-between; padding: 8px 14px 0; font-size: .8rem; color: var(--muted); }
  figcaption { display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 6px 14px 0; font-size: .82rem; color: var(--muted); }
  .key { display: inline-flex; align-items: center; gap: 8px; }
  .key i { width: 22px; height: 4px; border-radius: 4px; display: inline-block; }
  .k-flat { background: var(--flat); }
  .k-green { background: var(--accent); }
  .note { flex-basis: 100%; }

  /* ---------- intro states (only when JS is on) ---------- */
  :global(.js) [data-hide], :global(.js) [data-tagline], :global(.js) [data-form], :global(.js) [data-chart] {
    opacity: 0;
    /* Safety net: if the script never runs, everything appears after 7s. */
    animation: reveal 0.01s linear 7s forwards;
  }
  :global(.js) [data-hide] { transform: translateY(18px); transition: opacity .8s ease, transform .9s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--d, 0) * 260ms); }
  :global(.js) [data-chart] { transition: opacity .9s ease; }
  :global(.js) [data-tagline] { animation-name: reveal-tag; filter: blur(8px); letter-spacing: .08em; transition: opacity 1s ease, filter 1s ease, letter-spacing 1.1s cubic-bezier(.2,.7,.2,1); }
  :global(.js) [data-form] { transform: translateY(28px); transition: opacity .8s ease, transform .9s cubic-bezier(.2,.7,.2,1); }
  :global(.js) [data-counter] { opacity: 0; transition: opacity .5s ease; }

  .s-head [data-hide] { opacity: 1 !important; transform: none !important; }
  .s-chart [data-chart] { opacity: 1 !important; }
  .s-counter [data-counter] { opacity: 1 !important; }
  .s-tag [data-tagline] { opacity: 1 !important; filter: none !important; letter-spacing: 0 !important; }
  .s-form [data-form] { opacity: 1 !important; transform: none !important; }
  .is-static [data-hide], .is-static [data-tagline], .is-static [data-form], .is-static [data-chart], .is-static [data-counter] { opacity: 1 !important; transform: none !important; filter: none !important; transition: none !important; animation: none !important; }
  .is-static [data-tagline] { letter-spacing: 0 !important; }
  @keyframes reveal { to { opacity: 1; transform: none; filter: none; } }
  @keyframes reveal-tag { to { opacity: 1; filter: none; letter-spacing: 0; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-hide], :global(.js) [data-tagline], :global(.js) [data-form], :global(.js) [data-chart], :global(.js) [data-counter] { opacity: 1; transform: none; filter: none; animation: none; transition: none; }
    :global(.js) [data-tagline] { letter-spacing: 0; }
  }

  /* ---------- settled: slow, quiet life ---------- */
  .is-settled .glow { animation: pulse 5.5s ease-in-out infinite alternate; }
  .is-settled .area.shift { animation: drift 9s ease-in-out infinite alternate; }
  .is-offscreen .glow, .is-offscreen .area.shift { animation-play-state: paused; }
  @keyframes pulse { from { opacity: .08; } to { opacity: .42; } }
  @keyframes drift { from { opacity: 0; } to { opacity: .75; } }
  @media (prefers-reduced-motion: reduce) { .is-settled .glow, .is-settled .area.shift { animation: none; } }
</style>

<script>
  import '../scripts/hero';
</script>
