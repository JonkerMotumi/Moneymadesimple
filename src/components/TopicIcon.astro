---
interface Props { icon: string; size?: number }
const { icon, size = 24 } = Astro.props;
---
<svg class="topic-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon} />
