---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { allPosts, slugify } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await allPosts();
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((c) => ({ params: { category: slugify(c) }, props: { name: c, posts: posts.filter((p) => p.data.category === c) } }));
}
const { name, posts } = Astro.props;
---
<Base title={`${name} articles`} description={`Articles about ${name.toLowerCase()} from Money Made Simple.`}>
  <div class="wrap page-head">
    <p class="eyebrow"><a href="/blog" style="text-decoration:none">Blog</a></p>
    <h1>{name}</h1>
  </div>
  <div class="wrap"><div class="grid">{posts.map((p) => <PostCard post={p} />)}</div></div>
</Base>
