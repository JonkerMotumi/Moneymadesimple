---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, slugify } from '../../lib/blog';

const posts = await allPosts();
const cats = [...new Set(posts.map((p) => p.data.category))];
---
<Base title="Blog" description="Plain-English articles explaining the thinking behind each Money Made Simple calculator, with the calculator right there to try.">
  <div class="wrap page-head">
    <p class="eyebrow">The blog</p>
    <h1>The thinking behind the numbers.</h1>
    <p>Each article explains one money decision in plain English, then lets you try it with your own figures. Open to everyone.</p>
    <p class="cats">{cats.map((c) => <a class="pill" href={`/blog/category/${slugify(c)}`}>{c}</a>)}</p>
  </div>
  <div class="wrap"><div class="grid">{posts.map((p) => <PostCard post={p} />)}</div></div>
</Base>
<style>.cats { display: flex; flex-wrap: wrap; gap: 8px; }</style>
